# ============================================================
# AirbnbHost Notion template — configuration
# Copy this file to `.env` and fill it in (or pass flags on the CLI).
#   Note: `.env` here is git-ignored so your token is never committed.
# ============================================================

# REQUIRED — your Notion integration token (starts with "ntn_", older keys start "secret_").
# Create one at https://www.notion.so/my-integrations and give it access to the
# workspace/page you want to build into.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — build inside an existing page instead of a brand-new top-level page.
# Paste the 32-char page ID here. Leave blank to create a new top-level "AirbnbHost".
NOTION_PARENT_PAGE_ID=

# The dashboard/template page name.
NOTION_PAGE_NAME=AirbnbHost

# Your property (this becomes the first card in the Properties gallery).
NOTION_PROPERTY_NAME=1 Vulcan Lane, Ahuriri, Napier
NOTION_PROPERTY_TYPE=House

# Booking rate + discount (used to display the Current Booking Rate).
NOTION_REGULAR_RATE=0
NOTION_DISCOUNT_PERCENT=0

# OPTIONAL — an external image URL used as the property card cover photo.
# Replace with your own (e.g. your listing photo) after the build.
NOTION_PROPERTY_COVER_URL=
